# App Settings
PROJECT_NAME="fast-api-auth"
VERSION="0.1.0"
API_V1_STR="/api/v1"

# PostgreSQL async connection (asyncpg)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/fast_api_auth"

# JWT Security
SECRET_KEY="supersecretjwtkeyforlocaldevelopmentchangeinproduction"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

